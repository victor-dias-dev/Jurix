# Copy to .env at the repository root: cp .env.example .env
# The API and Knex read this file. Do not commit .env.

# ===========================================
# DATABASE (host-side; the container uses POSTGRES_* below)
# ===========================================
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=jurix
DB_PASSWORD=jurix_dev_2024
DB_DATABASE=jurix_db

# ===========================================
# PGADMIN (optional: docker compose --profile tools up)
# ===========================================
PGADMIN_EMAIL=admin@jurix.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ===========================================
# JWT (required; the API refuses to boot without these)
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# BACKEND
# ===========================================
BACKEND_PORT=3001
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ===========================================
# FRONTEND
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000
